# Copy to /etc/infrastructure-agent/agent.env and restrict it to root.
INFRA_AGENT_CONFIG=/var/lib/infrastructure-agent/agent_config.json
INFRA_AGENT_SSH_USERNAME=
INFRA_AGENT_SSH_KEY=/var/lib/infrastructure-agent/.ssh/id_ed25519
INFRA_AGENT_SSH_KNOWN_HOSTS=/var/lib/infrastructure-agent/.ssh/known_hosts
INFRA_AGENT_AI_BASE_URL=
INFRA_AGENT_AI_MODEL=
OPENAI_API_KEY=
