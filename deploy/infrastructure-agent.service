[Unit]
Description=Infrastructure Agent LAN administrator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=infrastructure-agent
Group=infrastructure-agent
WorkingDirectory=/var/lib/infrastructure-agent
Environment=HOME=/var/lib/infrastructure-agent
Environment=XDG_STATE_HOME=/var/lib/infrastructure-agent/.local/state
Environment=XDG_DATA_HOME=/var/lib/infrastructure-agent/.local/share
EnvironmentFile=-/etc/infrastructure-agent/agent.env
ExecStart=/var/lib/infrastructure-agent/.venv/bin/infrastructure-agent
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/infrastructure-agent

[Install]
WantedBy=multi-user.target
